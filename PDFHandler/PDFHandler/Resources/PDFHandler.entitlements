<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox is off: the app reads/writes PDFs anywhere the user
         chooses. An ad-hoc signed local-only build does not benefit
         from sandbox containment. Turn it on and add
         com.apple.security.files.user-selected.read-write if you
         ever distribute this through the Mac App Store. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
